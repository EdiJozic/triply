# Supabase client-side project values (anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Anthropic key; omit to use clearly labeled deterministic demo suggestions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Server-side OpenWeather key; forecasts remain unavailable until configured
OPENWEATHER_API_KEY=

# Optional verified maps/places provider key (server-side only)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Optional email invitations
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Configure storage/encryption and deployment through platform secret management
